# Local development values only. Copy to .env and replace the password.
# Do not use this file or its sample password in staging or production.
POSTGRES_DB=lefteria
POSTGRES_USER=lefteria
POSTGRES_PASSWORD=replace-with-a-unique-local-password
DATABASE_APP_USER=lefteria_app
DATABASE_APP_PASSWORD=replace-with-a-separate-local-password
# Opt-in web admin requires a separate provisioned credential-reading role.
WEB_ADMIN_ENABLED=false
DATABASE_ADMIN_AUTH_USER=lefteria_admin_auth
DATABASE_ADMIN_AUTH_PASSWORD=
WEB_ADMIN_THROTTLE_KEY=
# Generate each independently: openssl rand -base64 32
MOBILE_SIGNING_KEY=
MOBILE_OTP_KEY=
# Disabled until an approved same-origin cutover. The old secret is literal
# UTF-8 JWT_SECRET, not a base64-decoded rewrite signing key. Never commit it.
LEGACY_MOBILE_BRIDGE_ENABLED=false
LEGACY_MOBILE_SIGNING_SECRET=
# Generate independently from every other key: openssl rand -base64 32
LEGACY_MOBILE_FINGERPRINT_KEY=
# Explicit UTC acceptance interval; leave blank while disabled.
LEGACY_MOBILE_BRIDGE_STARTS_AT=
LEGACY_MOBILE_BRIDGE_ENDS_AT=
# Keep this IP and the subnet aligned; only this peer's forwarded headers are trusted.
APP_NETWORK_SUBNET=172.28.90.0/24
# Dynamic allocations exclude the fixed trusted proxy address below.
APP_NETWORK_DYNAMIC_RANGE=172.28.90.128/25
TRUSTED_PROXY_IP=172.28.90.2
# Leave unset until an approved real SMS integration test.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
PUBLIC_ORIGIN=https://localhost
SITE_ADDRESS=localhost

# Payabl hosted payment link sandbox. Never set credentials in source.
# This integration cannot send live money or card payouts.
Payabl__Enabled=false
Payabl__Sandbox=true
Payabl__MerchantId=
Payabl__Secret=
# Public HTTPS origin of the isolated OS preview (not original live site).
Payabl__PublicOrigin=

# Fan HUB sandbox HPP checkout (initial payment only; recurring billing is OFF).
# All prices are server-configured integer EUR cents. No client amount accepted.
# Requires ASPNETCORE_ENVIRONMENT=Staging and Payabl sandbox credentials.
HubFanPayabl__Enabled=false
HubFanPayabl__ParentMonthlyCents=0
HubFanPayabl__PlayerMonthlyCents=0
HubFanPayabl__BothMonthlyCents=0

# Private weekly in-app delivery. Never enable against live production.
# Provision isolated *_staging, *_preview or *_test database and a distinct
# lefteria_hub_scheduler login with only one EXECUTE grant.
HubLearningScheduler__Enabled=false
HubLearningScheduler__IsolatedStaging=false
HubLearningScheduler__ConnectionString=

# Optional SMS delivery of sandbox training-fee links, to OTP-verified
# guardian numbers only. Enabled=false performs NO Twilio API calls.
# Credentials must be supplied in an environment secret store, never Git.
TwilioPaymentSms__Enabled=false
TwilioPaymentSms__AccountSid=
TwilioPaymentSms__AuthToken=
TwilioPaymentSms__MessagingServiceSid=

# Disabled unless an operator supplies a real P-256 VAPID keypair and contact.
# Device notifications are generic (no announcement/member content).
# Generate VAPID keys outside the repository; do not commit private values.
WEB_PUSH_ENABLED=false
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=
