{$SITE_ADDRESS:localhost} {
  encode zstd gzip

  # Defense-in-depth for public, mobile and admin browser responses.
  # Do not enforce a CSP without first testing the current app and providers.
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    X-Frame-Options SAMEORIGIN
  }

  # Private application shells, transaction routes and authenticated API
  # responses must never be indexed or stored by browser/shared caches.
  # Segment boundaries avoid matching public paths such as /academy.
  # Apply after upstream headers, including error and redirect responses.
  @private_routes path_regexp private_routes (?i)^/(admin|app|login|profile|register|checkout|cart|payments|api/(admin|mobile))(/|$)
  header @private_routes {
    X-Robots-Tag "noindex, nofollow, noarchive"
    Cache-Control "private, no-store"
    defer
  }

  @api path /api/*
  reverse_proxy @api api:8080

  reverse_proxy web:3000
}
