# Copy only to a protected, dedicated preview directory; never use production keys.
PREVIEW_HOST=preview.example.invalid
# Keep loopback until certificate, access gate and private-network checks pass.
PREVIEW_BIND=127.0.0.1
PREVIEW_BIND_IPV6=::1
# Published regular PEM pair under tls/current; never mount Certbot live symlinks alone.
PREVIEW_CERT_DIRECTORY=/srv/lefteria-os-preview/tls
PREVIEW_MANIFEST_DIRECTORY=/srv/lefteria-os-preview/manifests
PREVIEW_API_IMAGE=
PREVIEW_WEB_IMAGE=
PREVIEW_IMPORT_IMAGE=
PREVIEW_OWNER_PASSWORD=
PREVIEW_APP_PASSWORD=
PREVIEW_SIGNING_KEY=
PREVIEW_OTP_KEY=
PREVIEW_GATE_HASH=
# Separate admin credential connection; enable only after migrations and explicit role provisioning.
PREVIEW_WEB_ADMIN_ENABLED=false
PREVIEW_ADMIN_AUTH_PASSWORD=
PREVIEW_ADMIN_THROTTLE_KEY=
