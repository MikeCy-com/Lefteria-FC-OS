{
  "name": "lefteria-fc-os-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "api:export": "node scripts/export-openapi.mjs",
    "api:generate": "node ../tools/api-client/generate.mjs",
    "smoke:web": "node scripts/smoke-web.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "build": "vite build",
    "preview": "node build"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0",
    "@sveltejs/kit": "3.1.0",
    "svelte": "5.57.2"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "6.0.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "svelte-check": "4.7.7",
    "typescript": "^6.0.0",
    "vite": "8.3.5"
  }
}
